# 複製這個檔案為 .env 並填入實際值，.env 已被 .gitignore 排除，不會進版控。

# Groq API（晨報內容產生，有免費額度），取得方式：https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LINE Messaging API（推播晨報），取得方式：https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
# 目前程式只用 Push Message，不處理 webhook，所以 CHANNEL_SECRET 暫時用不到，先留著備用
LINE_CHANNEL_SECRET=
# 加官方帳號好友後，透過 webhook 或第三方工具取得自己的 LINE User ID
LINE_USER_ID=

# GitHub Pages 網址（選填，供推播訊息附連結用）
GITHUB_PAGES_URL=

# Discord 行程／收藏連結來源，取得方式見 memory/README.md 或 README.md 的設定說明
# 建立 Bot：https://discord.com/developers/applications （記得開 Message Content Intent）
DISCORD_BOT_TOKEN=
# 開發者模式下對頻道按右鍵「複製頻道 ID」取得
DISCORD_CALENDAR_CHANNEL_ID=
DISCORD_INTERESTING_LINKS_CHANNEL_ID=
