# 複製這個檔案為 .env 並填入實際值，.env 已被 .gitignore 排除，不會進版控。

# Groq API（晨報內容產生，有免費額度），取得方式：https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub Pages 網址（用來組「今天的晨報網址」推到 Discord，例如
# https://inso803.github.io/ClaudeAssistant）
GITHUB_PAGES_URL=

# Discord 行程／收藏連結來源，取得方式見 memory/README.md 或 README.md 的設定說明
# 建立 Bot：https://discord.com/developers/applications （記得開 Message Content Intent）
DISCORD_BOT_TOKEN=
# 開發者模式下對頻道按右鍵「複製頻道 ID」取得
DISCORD_CALENDAR_CHANNEL_ID=
DISCORD_INTERESTING_LINKS_CHANNEL_ID=
# ver2：晨報推播頻道（只推今天的網址連結）。不設定的話 config.py 有預設值，
# 通常不需要在這裡填
DISCORD_MORNING_BRIEF_CHANNEL_ID=

# Brave Search API（根據收藏興趣推薦相關新內容用，有免費額度），取得方式：
# https://brave.com/search/api/ → 註冊 → Free tier（2000 次查詢/月）→ 取得 API Key
# 沒設定的話這個來源會自動跳過，不影響其他來源／其他功能
BRAVE_SEARCH_API_KEY=

# YouTube Data API v3（選填），取得方式：Google Cloud Console 建專案 → 啟用
# 「YouTube Data API v3」→ 建立 API 金鑰。沒設定就自動跳過這個來源
YOUTUBE_API_KEY=

# Eventbrite Personal OAuth Token（選填），取得方式：Eventbrite 帳號的 API keys 頁面。
# 注意：Eventbrite 已於 2019 年底停用第三方公開活動搜尋 API，設定了也可能查不到結果
EVENTBRITE_API_TOKEN=
