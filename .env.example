# 複製這個檔案為 .env 並填入實際值，.env 已被 .gitignore 排除，不會進版控。

# Claude API（晨報內容產生），取得方式：https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# LINE Messaging API（推播晨報），取得方式：https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
# 目前程式只用 Push Message，不處理 webhook，所以 CHANNEL_SECRET 暫時用不到，先留著備用
LINE_CHANNEL_SECRET=
# 加官方帳號好友後，透過 webhook 或第三方工具取得自己的 LINE User ID
LINE_USER_ID=

# GitHub Pages 網址（選填，供推播訊息附連結用）
GITHUB_PAGES_URL=
